TELEGRAM_BOT_TOKEN=token
TELEGRAM_BOT_NAME=name
HOST=example.com
PUBLIC_BASE_URL=https://example.com
ALLOWED_HOSTS=example.com,127.0.0.1,localhost
USE_X_FORWARDED_HOST=true
WEB_BIND_ADDRESS=127.0.0.1
WEB_PORT=18000
PROXY_NETWORK=npm_proxy

# VK OAuth login. VK_APP_SECRET is the protected/secure app key.
VK_APP_ID=your_vk_app_id
VK_APP_SECRET=your_vk_protected_key
VK_OAUTH_VERSION=5.131
VK_MINI_APP_AUTH_MAX_AGE=3600

# VK community bot. Use the community access token from the group's API settings.
VK_GROUP_ID=your_vk_group_id
VK_GROUP_TOKEN=your_vk_community_access_token

YANDEX_API_KEY=YOUR_YANDEX_API_KEY_HERE
YANDEX_FOLDER_ID=YOUR_YANDEX_FOLDER_ID_HERE
REDIS_URL=redis://default:password@localhost:6379/0

# Postgres settings (used in docker-compose)
# POSTGRES_DB=memo
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=postgres
# POSTGRES_HOST=db
# POSTGRES_PORT=5432
